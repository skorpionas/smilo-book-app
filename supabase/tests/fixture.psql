-- Shared fixture for pgTAP tests. Included by each test file with \ir.
-- Creates two owners and a small dataset for owner 1. Runs as postgres
-- (bypasses RLS); tests switch role explicitly where RLS matters.

insert into auth.users (id, email) values
  ('11111111-1111-4111-8111-111111111111', 'owner1@test.local'),
  ('22222222-2222-4222-8222-222222222222', 'owner2@test.local');

