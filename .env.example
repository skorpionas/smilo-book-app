# Copy to .env.local. Public values only — there is NO service-role key in this app.
# Which stack is which: docs/environments.md

# Local stack (`pnpm db:start` prints these). To point a local build at the hosted
# DEV project instead use https://gfnrlbpiqdmlkuyhbwde.supabase.co and its
# publishable key. Never put the PROD project here — the build refuses it.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# local | preview | production — shows the "LOCAL"/"DEV" badge on non-production.
# On Vercel set it per environment (Production=production, Preview=preview,
# Development=local); if unset it is derived from VERCEL_ENV.
# next.config.ts fails the build if production is not on the PROD Supabase
# project (qxfovtpskynncfkygpzg) or if preview/local is.
NEXT_PUBLIC_APP_ENV=local

# Sentry (issue #20): EU-region project (DSN host *.ingest.de.sentry.io). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
# Build only (Vercel), for readable stack traces: org auth token + slugs. Empty = no upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
